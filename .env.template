# --- Client-visible (Vite build) ---
# Do NOT set VITE_OPENAI_API_KEY or VITE_FAL_KEY on hosted deploys — they are compiled
# into public JS. Use server-only OPENAI_API_KEY and FAL_KEY below instead.

# Stability AI (optional; still called from the browser when configured)
VITE_STABILITY_API_KEY=

# Image provider override. One of: fal | openai | stability | auto (default).
# - auto: fal when no Stability key (OpenAI/fal keys are server-side when proxied)
# - explicit value forces that provider regardless of which keys are set
VITE_IMAGE_PROVIDER=auto

# Firebase / Google Cloud Firestore (study usage data + embedded storyboard image).
# Copy these from your Firebase project's web app config. Cloud Storage is not used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local dev only (optional fallbacks; prefer OPENAI_API_KEY / FAL_KEY above) ---
# VITE_OPENAI_API_KEY=
# VITE_FAL_KEY=

# --- Server-only (scripts/dev-server.mjs / production API behind NGINX) ---
# OpenAI: text generation + image generate/edit (required for hosted study)
OPENAI_API_KEY=

# fal.ai: Flux Schnell + Kontext via /api/fal/proxy (recommended for image gen)
FAL_KEY=

# Comma-separated allowlisted access IDs for the login gate. Not exposed to the browser.
ACCESS_ALLOWLIST=pilot01,pilot02
# Secret used to HMAC-sign the se_session cookie. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Set true behind HTTPS in production so the session cookie includes Secure.
SESSION_COOKIE_SECURE=false
# Cookie Path for the access session (must match the app subpath on a shared host).
SESSION_COOKIE_PATH=/storyweaver

